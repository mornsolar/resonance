---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getPublishedStories } from '../../lib/stories';

const stories = await getPublishedStories();
---
<Base title="Stories" description="Real moments from everyday life with technology and the people we love, each ending with a question to sit with.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Stories</p>
        <h1>Stories about what matters</h1>
        <p class="lede">Real moments from my own life with technology and the people I love. Each one ends with a question to sit with, not a list of more things to read.</p>
      </div>
      <div class="grid">
        {stories.map((story) => <StoryCard story={story} />)}
      </div>
    </div>
  </section>
</Base>
