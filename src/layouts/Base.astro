---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/work-sans/wght.css';
import '../styles/global.css';
import SundayPause from '../components/SundayPause.astro';
import { url } from '../lib/url';
import { SITE_NAME, FOUNDER_NAME, CONTACT_EMAIL, LINKEDIN_URL } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  hidePause?: boolean;
  quietCapable?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const DEFAULT_DESCRIPTION =
  'A place to explore how we can build a wiser relationship with technology, with ourselves, and with the people around us.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  hidePause = false,
  quietCapable = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · A little less scrolling. A little more living.`;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.png'), Astro.site).href;
const pauseHref = hidePause ? url('/#sunday-pause') : '#sunday-pause';

const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: DEFAULT_DESCRIPTION,
  url: new URL(url('/'), Astro.site).href,
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');

const navItems = [
  { href: url('/stories/'), label: 'Stories' },
  { href: url('/try/'), label: 'Try' },
  { href: url('/speaking/'), label: 'Speaking' },
  { href: url('/about/'), label: 'About' },
];

function isCurrent(href: string): boolean {
  const target = href.replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
}
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F7F5EE" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111815" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')}>
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: stories`} href={url('/rss.xml')}>
  <link rel="sitemap" href={url('/sitemap-index.xml')}>
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={structuredDataJson}></script>
  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
  {quietCapable && (
    <script is:inline>
      try {
        if (localStorage.getItem('understory-quiet-reading') === 'on') document.documentElement.classList.add('quiet');
      } catch (error) {
        /* storage blocked: reading mode simply stays off */
      }
    </script>
  )}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={url('/')}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path class="brand-sun" d="M9 23A7 7 0 0 1 23 23Z" />
          <path class="brand-ring" d="M4 23A12 12 0 0 1 28 23" stroke-width="2.4" />
          <line class="brand-horizon" x1="2.5" y1="23" x2="29.5" y2="23" stroke-width="2.4" />
        </svg>
        {SITE_NAME}
      </a>

      <nav class="nav nav-desktop" aria-label="Main">
        {navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="nav-cta" href={pauseHref}>The Sunday Pause</a>
      </nav>

      <details class="nav-mobile" data-menu>
        <summary>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 8h16M4 16h16" />
          </svg>
          Menu
        </summary>
        <nav class="menu-panel" aria-label="Main">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="nav-cta" href={pauseHref}>The Sunday Pause</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  {!hidePause && <SundayPause />}

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <p class="footer-brand">{SITE_NAME}</p>
          <p class="footer-note">A little less scrolling. A little more living.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={url('/check/')}>Phone check-in</a>
          <a href={url('/reset/')}>One-week reset</a>
          <a href={url('/privacy/')}>Privacy</a>
          <a href={url('/rss.xml')}>RSS</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
        </nav>
      </div>
      <p class="footer-legal">© {new Date().getFullYear()} {FOUNDER_NAME}. Made to be left, not scrolled.</p>
    </div>
  </footer>

  <script>
    import '../scripts/forms';
    import '../scripts/menu';
  </script>
</body>
</html>
