---
const radii = [58, 92, 128, 164, 194];
---
<div class="ripples" aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false">
    <defs>
      <radialGradient id="ripples-glow" cx="50%" cy="50%" r="50%">
        <stop class="glow-start" offset="0%" />
        <stop class="glow-end" offset="100%" />
      </radialGradient>
    </defs>
    <circle cx="200" cy="200" r="199" fill="url(#ripples-glow)" />
    {radii.map((r, i) => (
      <circle class="ring" style={`--i:${i}; opacity:${(0.75 - i * 0.12).toFixed(2)}`} cx="200" cy="200" r={r} fill="none" />
    ))}
    <circle class="core" cx="200" cy="200" r="16" />
    <circle class="spark" cx="200" cy="200" r="6" />
  </svg>
</div>

<style>
  .ripples { width: min(68%, 420px); aspect-ratio: 1; justify-self: center; }
  @media (min-width: 900px) {
    .ripples { width: min(100%, 420px); }
  }
  svg { width: 100%; height: 100%; display: block; }
  .glow-start { stop-color: var(--sage); stop-opacity: 0.95; }
  .glow-end { stop-color: var(--sage); stop-opacity: 0; }
  .ring { stroke: var(--forest); stroke-width: 1.6; }
  .core { fill: var(--forest); }
  .spark { fill: var(--dawn); }

  @media (prefers-reduced-motion: no-preference) {
    .ring {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 9s ease-in-out infinite;
      animation-delay: calc(var(--i) * -1.8s);
    }
  }

  @keyframes breathe {
    0%, 100% { transform: scale(0.97); }
    50% { transform: scale(1.03); }
  }
</style>
