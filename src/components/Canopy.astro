---
// The Understory mark at hero size: two rings rising over a horizon, with the sun just up.
const HORIZON = 268;
const CENTER = 200;
const rings = [
  { r: 92, opacity: 0.8 },
  { r: 150, opacity: 0.45 },
];
const arc = (r: number) => `M${CENTER - r} ${HORIZON} A${r} ${r} 0 0 1 ${CENTER + r} ${HORIZON}`;
---
<div class="canopy" aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false">
    <defs>
      <radialGradient id="canopy-glow" cx="50%" cy="50%" r="50%">
        <stop class="glow-start" offset="0%" />
        <stop class="glow-end" offset="100%" />
      </radialGradient>
    </defs>
    <circle cx="200" cy="200" r="199" fill="url(#canopy-glow)" />
    {rings.map((ring, i) => (
      <path class="ring" style={`--i:${i}; opacity:${ring.opacity}`} d={arc(ring.r)} fill="none" />
    ))}
    <path class="sun" d={`M${CENTER - 42} ${HORIZON} A42 42 0 0 1 ${CENTER + 42} ${HORIZON} Z`} />
    <line class="horizon" x1="52" y1={HORIZON} x2="348" y2={HORIZON} />
  </svg>
</div>

<style>
  .canopy { width: min(68%, 420px); aspect-ratio: 1; justify-self: center; }
  @media (min-width: 900px) {
    .canopy { width: min(100%, 420px); }
  }
  svg { width: 100%; height: 100%; display: block; }
  .glow-start { stop-color: var(--sage); stop-opacity: 0.95; }
  .glow-end { stop-color: var(--sage); stop-opacity: 0; }
  .ring { stroke: var(--forest); stroke-width: 1.8; stroke-linecap: round; }
  .horizon { stroke: var(--forest); stroke-width: 2; stroke-linecap: round; }
  .sun { fill: var(--dawn); }

  @media (prefers-reduced-motion: no-preference) {
    .ring {
      transform-box: view-box;
      transform-origin: 200px 268px;
      animation: breathe 9s ease-in-out infinite;
      animation-delay: calc(var(--i) * -3s);
    }
  }

  @keyframes breathe {
    0%, 100% { transform: scale(0.98); }
    50% { transform: scale(1.03); }
  }
</style>
