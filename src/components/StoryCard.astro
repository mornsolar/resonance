---
import { formatDate, readingMinutes, type Story } from '../lib/stories';
import { url } from '../lib/url';

interface Props {
  story: Story;
  featured?: boolean;
  as?: 'h2' | 'h3';
}

const { story, featured = false, as: Heading = 'h3' } = Astro.props;
const href = url(`/stories/${story.id}/`);
const minutes = readingMinutes(story);
---
<article class:list={['card', { 'card-featured': featured }]}>
  <span class="meta">{formatDate(story.data.date)} · {minutes} min read</span>
  <Heading><a href={href}>{story.data.title}</a></Heading>
  <p>{story.data.summary}</p>
  <span class="more" aria-hidden="true">Read the story →</span>
</article>
